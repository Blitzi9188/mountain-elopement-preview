# WordPress → static relaunch redirects for mountain-elopement.com
# Format: Netlify / Cloudflare Pages "_redirects". Also valid on Netlify.
# Use EITHER this file OR netlify.toml, not both, to avoid conflicting rules.

# Old WordPress author/team page → new team page
/blitzkneisser/    /our-team/    301

# Retired private client gallery — return 410 Gone (no redirect) so it drops from the index.
# Netlify serves /410.html with a 410 status. No proofing-gallery file exists in the build,
# so the rule always applies (static files would otherwise take precedence).
/proofing-gallery/proofing-gallery-locked/   /410.html   410
/proofing-gallery/*                          /410.html   410
