# Cache-Control — versionierte Assets (Cache-Buster ?v=<hash> bei CSS/JS,
# eindeutige Dateinamen bei Bildern/Fonts) duerfen unveraenderlich lange cachen.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Cache-Control: public, max-age=0, must-revalidate
